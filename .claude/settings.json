{
  "permissions": {
    "allow": [
      "WebFetch(domain:www.w3.org)",
      "WebFetch(domain:opentelemetry.io)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-line-comments.ps1"]
          },
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-raw-config.ps1"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/remind-rule-update.ps1"]
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "betterstack": {
      "source": { "source": "github", "repo": "BetterStackHQ/claude-plugin" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "betterstack@betterstack": true
  }
}
